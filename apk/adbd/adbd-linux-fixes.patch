diff --git a/adb/diagnose_usb.cpp b/adb/diagnose_usb.cpp
index 0f067b0..75cddad 100644
--- a/adb/diagnose_usb.cpp
+++ b/adb/diagnose_usb.cpp
@@ -16,6 +16,26 @@
 
 #include "diagnose_usb.h"
 
+
+/* musl 无 group_member(3), 提供兼容实现 */
+#if !defined(__GLIBC__) && !defined(__ANDROID__)
+#include <unistd.h>
+#include <grp.h>
+static int group_member(gid_t gid) {
+    int n = getgroups(0, NULL);
+    if (n <= 0) return 0;
+    gid_t* groups = (gid_t*)malloc(sizeof(gid_t) * n);
+    if (!groups) return 0;
+    n = getgroups(n, groups);
+    int found = 0;
+    for (int i = 0; i < n; i++) {
+        if (groups[i] == gid) { found = 1; break; }
+    }
+    free(groups);
+    return found;
+}
+#endif
+
 #include <errno.h>
 #include <unistd.h>
 
