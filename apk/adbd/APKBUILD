14e0c7fb3588a8f8dc82787796e3857677fdf6ffd7a60bd1bd2bcb883214050bc87a701360f5eb02a5bd041065730e32bd483245dff57262ac5ecf9644743a9f  adbd.initd
c127b2199674390690889928fc2377a1fd6d8b9fea5d6dc5b3a8ad35fe5b63e77d0c6a8c3dac31d8b347420a10c86156161102dca95af30e8a2068772b26608b  adbd.confd

"
