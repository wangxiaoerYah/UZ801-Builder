# Maintainer: wangxiaoerYah <openstick-builder@users.noreply.github.com>
pkgname=adbd
pkgver=1.0.0
pkgrel=0
pkgdesc="Android Debug Bridge daemon for Linux (UZ801 OpenStick)"
url="https://github.com/wangxiaoerYah/adbd-linux"
arch="aarch64"
license="Apache-2.0"
depends="openssl libcap"
makedepends="openssl-dev libcap-dev linux-headers glib-dev"
options="!check"
source="adbd-linux.tar.gz
	adbd.initd
	adbd.confd"

builddir="$srcdir/adbd-linux"

build() {
	cd "$builddir"
	# 确保无残留 (防止宿主 glibc 产物混入, 导致 musl 环境链接错误)
	make clean >/dev/null 2>&1 || true
	# openssl 3.x 兼容修复已包含在源码; 抑制弃用警告
	# AR/RANLIB 必须显式指定 (Makefile 的 ${RANLIB} 未定义会出错)
	make CC=cc CXX=c++ AR=ar RANLIB=ranlib \
		LFLAGS="-Wno-deprecated-declarations -D_GNU_SOURCE -std=gnu++14" \
		LDFLAGS="-lcap"
}

package() {
	cd "$builddir"
	install -Dm755 adb/adbd "$pkgdir"/usr/bin/adbd
	install -Dm644 "$srcdir"/adbd.initd "$pkgdir"/etc/init.d/adbd
	install -Dm644 "$srcdir"/adbd.confd "$pkgdir"/etc/conf.d/adbd
}

sha512sums="
